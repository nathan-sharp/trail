# Public base URL used in OpenSearch 1.1 XML descriptors (no trailing slash)
TRAIL_BASE_URL=http://localhost:8080

# Fallback host path if no external USB drive >= 500 GB is attached
TRAIL_USB_MOUNT_PATH=./data

# Optional explicit block device override (e.g., /dev/sda1).
# Leave empty to auto-detect the non-boot USB disk >= 500 GB.
TRAIL_USB_DEVICE=

# Minimum USB disk capacity in gigabytes (GB) for automatic detection
TRAIL_MIN_USB_GB=500

# Automatically partition and format the detected USB drive as ext4 (label TRAIL_DATA)
# on first boot if it does not yet carry the TRAIL_DATA label.
TRAIL_AUTO_FORMAT=true

# Open-hop crawler limits
TRAIL_MAX_HOP_DEPTH=2
TRAIL_MAX_PAGES_PER_DOMAIN=50
TRAIL_CRAWL_DELAY_SECONDS=2
TRAIL_CRAWL_BATCH_SIZE=10
TRAIL_CRAWL_INTERVAL_SECONDS=30

# Query pagination size (results per page)
TRAIL_RESULTS_PER_PAGE=10

# Cloudflare Tunnel token (obtain from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_your_cloudflare_tunnel_token
